# Сервер
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=true

# База данных (SQLite по умолчанию для быстрого запуска, либо PostgreSQL)
DATABASE_URL="file:./dev.db"

# Telegram-бот (Создайте бота в @BotFather и укажите токен)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=YourAiServicesBot
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
TELEGRAM_TOPIC_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=super_secret_random_string_64_chars

# Защита от спама (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxx
TURNSTILE_ENABLED=false

# Geo-IP (Опциональный путь к базе MaxMind mmdb)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
